
import random


# Function 1: Display Hangman drawing
def display_hangman(wrong_guesses):

    stages = [
        """
         +---+
         |   |
             |
             |
             |
        =========
        """,
        """
         +---+
         |   |
         O   |
             |
             |
        =========
        """,
        """
         +---+
         |   |
         O   |
         |   |
             |
        =========
        """,
        """
         +---+
         |   |
         O   |
        /|   |
             |
        =========
        """,
        """
         +---+
         |   |
         O   |
        /|\\  |
             |
        =========
        """,
        """
         +---+
         |   |
         O   |
        /|\\  |
        /    |
        =========
        """,
        """
         +---+
         |   |
         O   |
        /|\\  |
        / \\  |
        =========
        """
    ]

    print(stages[wrong_guesses])


# Function 2: Display hidden word
def display_word(secret_word, guessed_letters):

    display = ""

    for letter in secret_word:

        if letter in guessed_letters:
            display = display + letter + " "
        else:
            display = display + "_ "

    return display


# Function 3: Main game
def play_game():

    words = [
        "PYTHON",
        "APPLE",
        "ORANGE",
        "COMPUTER",
        "SCIENCE",
        "PROGRAM",
        "DATABASE",
        "KEYBOARD",
        "BIOLOGY",
        "FUNCTION"
    ]

    secret_word = random.choice(words)

    guessed_letters = set()

    wrong_guesses = 0

    max_attempts = 6

    print("\n================================")
    print("      HANGMAN WORD GAME")
    print("================================")

    print("\nGuess the hidden word!")
    print("You have 6 incorrect attempts.")
    print("Enter one letter at a time.\n")

    # Game loop
    while wrong_guesses < max_attempts:

        display_hangman(wrong_guesses)

        print("Word:", display_word(secret_word, guessed_letters))

        print("Guessed letters:", sorted(guessed_letters))

        print("Remaining attempts:", max_attempts - wrong_guesses)

        guess = input("\nEnter a letter: ").strip().upper()

        # Input validation
        if len(guess) != 1 or not guess.isalpha():

            print("Invalid input! Enter only one alphabet letter.")

            continue

        # Duplicate letter checking
        if guess in guessed_letters:

            print("You already guessed this letter!")

            print("No attempt will be deducted.")

            continue

        # Store guessed letter
        guessed_letters.add(guess)

        # Correct or incorrect guess
        if guess in secret_word:

            print("Correct guess!")

        else:

            print("Wrong guess!")

            wrong_guesses = wrong_guesses + 1

        # Check winning condition
        if "_" not in display_word(secret_word, guessed_letters):

            print("\n================================")
            print("       CONGRATULATIONS!")
            print("          YOU WON!")
            print("================================")

            print("The correct word is:", secret_word)

            print("Total wrong guesses:", wrong_guesses)

            return

    # Losing condition
    display_hangman(wrong_guesses)

    print("\n================================")
    print("          GAME OVER!")
    print("================================")

    print("You have used all 6 attempts.")

    print("The correct word was:", secret_word)


# Function 4: Start the game
def main():

    while True:

        play_game()

        choice = input("\nDo you want to play again? (yes/no): ").strip().lower()

        if choice != "yes":

            print("\nThank you for playing Hangman!")

            break


# Execute the program
if __name__ == "__main__":
    main()
