
import csv
import os
from datetime import datetime


# Function 1: Get a positive number
def get_positive_number(message):

    while True:
        try:
            value = float(input(message))

            if value > 0:
                return value
            else:
                print("Please enter a number greater than zero.")

        except ValueError:
            print("Invalid input! Please enter a number.")


# Function 2: Get a positive whole number
def get_quantity(message):

    while True:
        try:
            value = int(input(message))

            if value > 0:
                return value
            else:
                print("Quantity must be greater than zero.")

        except ValueError:
            print("Please enter a whole number.")


# Function 3: Get latest available stock price
def get_current_price(ticker):

    try:
        import yfinance as yf

        stock = yf.Ticker(ticker)

        history = stock.history(period="5d")

        if not history.empty:
            price = history["Close"].dropna().iloc[-1]
            return float(price)

    except Exception:
        pass

    return None


# Function 4: Display portfolio details
def display_portfolio(portfolio):

    total_invested = 0
    total_market_value = 0

    print("\n==============================================")
    print("         STOCK PORTFOLIO SUMMARY")
    print("==============================================")

    print(
        f"{'Ticker':<10}"
        f"{'Invested':>12}"
        f"{'Market Value':>16}"
        f"{'Profit/Loss':>14}"
        f"{'Gain/Loss %':>14}"
    )

    print("-" * 66)

    for ticker, details in portfolio.items():

        buy_price = details["buy_price"]
        quantity = details["quantity"]
        current_price = details["current_price"]

        invested = buy_price * quantity

        market_value = current_price * quantity

        profit_loss = market_value - invested

        percentage = (profit_loss / invested) * 100

        total_invested += invested
        total_market_value += market_value

        print(
            f"{ticker:<10}"
            f"{invested:>12.2f}"
            f"{market_value:>16.2f}"
            f"{profit_loss:>14.2f}"
            f"{percentage:>13.2f}%"
        )

    total_profit_loss = total_market_value - total_invested

    if total_invested > 0:
        total_percentage = (
            total_profit_loss / total_invested
        ) * 100
    else:
        total_percentage = 0

    print("-" * 66)

    print("\nTOTAL INVESTED CAPITAL:", round(total_invested, 2))

    print("TOTAL MARKET VALUE:", round(total_market_value, 2))

    print("TOTAL PROFIT / LOSS:", round(total_profit_loss, 2))

    print("OVERALL GAIN / LOSS:", round(total_percentage, 2), "%")

    return total_invested, total_market_value, total_profit_loss, total_percentage


# Function 5: Save portfolio results into CSV
def save_to_csv(portfolio, totals):

    filename = "portfolio_summary.csv"

    file_exists = os.path.exists(filename)

    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    headers = [
        "Date and Time",
        "Ticker",
        "Buy Price",
        "Quantity",
        "Invested Capital",
        "Current Price",
        "Market Value",
        "Profit or Loss",
        "Gain or Loss Percentage"
    ]

    with open(filename, "a", newline="") as file:

        writer = csv.writer(file)

        # Write column headings only for a new file
        if not file_exists or os.path.getsize(filename) == 0:
            writer.writerow(headers)

        # Write individual stock details
        for ticker, details in portfolio.items():

            buy_price = details["buy_price"]
            quantity = details["quantity"]
            current_price = details["current_price"]

            invested = buy_price * quantity
            market_value = current_price * quantity
            profit_loss = market_value - invested
            percentage = (profit_loss / invested) * 100

            writer.writerow([
                timestamp,
                ticker,
                buy_price,
                quantity,
                round(invested, 2),
                round(current_price, 2),
                round(market_value, 2),
                round(profit_loss, 2),
                round(percentage, 2)
            ])

        # Write overall portfolio summary
        writer.writerow([
            timestamp,
            "PORTFOLIO TOTAL",
            "",
            "",
            round(totals[0], 2),
            "",
            round(totals[1], 2),
            round(totals[2], 2),
            round(totals[3], 2)
        ])

    print("\nPortfolio results saved successfully!")
    print("CSV File:", filename)


# Function 6: Main program
def main():

    portfolio = {}

    print("\n==============================================")
    print("       STOCK PORTFOLIO TRACKER")
    print("==============================================")

    print("\nEnter your hypothetical stock holdings.")

    while True:

        ticker = input("\nEnter stock ticker symbol: ").strip().upper()

        if not ticker:
            print("Ticker symbol cannot be empty.")
            continue

        if ticker in portfolio:
            print("This stock has already been entered.")
            continue

        buy_price = get_positive_number(
            "Enter purchase price per share: "
        )

        quantity = get_quantity(
            "Enter number of shares: "
        )

        print("\nLooking up the latest available price for", ticker)

        current_price = get_current_price(ticker)

        if current_price is None:

            print("Automatic price lookup unavailable.")

            current_price = get_positive_number(
                "Enter current market price manually: "
            )

        print("Current price:", round(current_price, 2))

        portfolio[ticker] = {
            "buy_price": buy_price,
            "quantity": quantity,
            "current_price": current_price
        }

        print("\nStock added successfully!")

        choice = input(
            "\nDo you want to add another stock? (yes/no): "
        ).strip().lower()

        if choice != "yes":
            break

    if not portfolio:
        print("No stocks were entered.")
        return

    totals = display_portfolio(portfolio)

    save_to_csv(portfolio, totals)

    print("\nThank you for using Stock Portfolio Tracker!")


# Execute the program
if __name__ == "__main__":
    main()
